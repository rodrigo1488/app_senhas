# Copie este arquivo para `.env` e ajuste os valores.

# --- PostgreSQL (serviço "db" do docker-compose) ---------------------------
POSTGRES_USER=appsenhas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=appsenhas

# API fora do Docker apontando para Postgres local (opcional):
# DATABASE_URL=postgresql+psycopg2://appsenhas:troque-esta-senha@localhost:5432/appsenhas

# --- Flask (api/) ----------------------------------------------------------
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ADMIN_EMAIL=admin@compuflow.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js (web/) --------------------------------------------------------
# URL que o browser usa para a API (rewrites no Next usam API_INTERNAL_URL)
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL interna container→container (ou localhost em dev)
API_INTERNAL_URL=http://api:5000

# --- Notificações Push (Web Push / VAPID) ----------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=seu-email@exemplo.com
