# Copie este arquivo para `.env` e ajuste os valores. O `docker-compose.yml`
# e o `backend/__init__.py` (via python-dotenv) leem essas variáveis.

# --- PostgreSQL (usado pelo docker-compose.yml para o serviço "db" e para
# montar o DATABASE_URL do backend) -------------------------------------
POSTGRES_USER=appsenhas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=appsenhas

# Se quiser rodar o backend fora do Docker apontando para um Postgres já
# existente, defina DATABASE_URL diretamente (tem prioridade sobre as
# variáveis POSTGRES_* acima nesse cenário). Sem essa variável definida, o
# backend cai no appsenhas.sqlite legado (ver _resolve_database_config).
# DATABASE_URL=postgresql+psycopg2://appsenhas:troque-esta-senha@localhost:5432/appsenhas

# --- Flask ---------------------------------------------------------------
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Supabase (login do painel admin) ------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- Notificações Push (Web Push / VAPID) --------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=seu-email@exemplo.com
