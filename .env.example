# Copie este arquivo para `.env` e ajuste os valores.

# --- PostgreSQL (serviço "db" do docker-compose) ---------------------------
POSTGRES_USER=appsenhas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=appsenhas

# API fora do Docker apontando para Postgres local (opcional):
# DATABASE_URL=postgresql+psycopg2://appsenhas:troque-esta-senha@localhost:5432/appsenhas

# Fuso oficial (São Paulo). A API também força America/Sao_Paulo no código.
TZ=America/Sao_Paulo

# --- Flask (api/) ----------------------------------------------------------
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ADMIN_EMAIL=admin@compuflow.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js (web/) --------------------------------------------------------
# Opcional no browser. Em HTTPS o app usa o mesmo domínio da página (rewrite
# do Next → Flask). Só precisa em HTTP local apontando direto na :5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL interna container→container (ou localhost em dev)
API_INTERNAL_URL=http://api:5000

# --- Notificações Push (Web Push / VAPID) ----------------------------------
# O par é gerado automaticamente e persistido no volume `api_instance`.
# Preencha apenas se quiser fornecer e gerenciar suas próprias chaves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@compuflow.local
